{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "command": ".cursor/hooks/tdd-start.sh",
        "matcher": "^(?:implementer|test-writer)$",
        "timeout": 10
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/tdd-unit-tests.sh",
        "matcher": "^(?:implementer|test-writer)$",
        "loop_limit": 8,
        "timeout": 300
      }
    ]
  }
}
