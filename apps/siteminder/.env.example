# Copy to .env.local. Everything is optional — the app runs fully without it.
#
# The Ticketek Support assistant reuses AGL's xAI proxy. Locally the dev server also reads
# apps/agl/.env.local, so if AGL already has XAI_API_KEY you don't need to set it here.
# Server-only: never prefix with VITE_.
XAI_API_KEY=
XAI_VOICE_MODEL=grok-voice-latest
# eve | ara | rex | sal | leo
XAI_VOICE=eve
XAI_CHAT_MODEL=grok-4.7
XAI_CHAT_REASONING=low
