# Copy to .env.local. Everything is optional — the app runs fully without it.

# Grok Voice (xAI realtime). When set, the AGL Assistant's Voice mode connects to Grok;
# without it the assistant falls back to a browser demo voice over the same flows.
# Server-only: never prefix with VITE_.
XAI_API_KEY=
XAI_VOICE_MODEL=grok-voice-latest
# eve | ara | rex | sal | leo
XAI_VOICE=eve
XAI_VOICE_TOKEN_TTL=300
